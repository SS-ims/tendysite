# ================================================
# Environment Variables - Copy to .env and fill in
# ================================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=1984
DB_NAME=tendy_db

# JWT Secret for Admin Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Email Configuration (Gmail SMTP)
# 1. Enable 2FA on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password-here

# Admin email to receive contact/enquiry notifications
ADMIN_EMAIL=admin@tendywoodlands.com

# Server Configuration
SERVER_PORT=3000
NODE_ENV=development
